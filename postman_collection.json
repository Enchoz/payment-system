						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fromUserId\": \"11111111-1111-1111-1111-111111111111\",\n  \"amount\": \"500.00\",\n  \"currency\": \"USD\",\n  \"targetCurrency\": \"EUR\",\n  \"externalIban\": \"FR1420041010050500013M02606\",\n  \"externalBankName\": \"French Bank\",\n  \"externalAccountHolderName\": \"Jean Dupont\",\n  \"externalCountryCode\": \"FR\",\n  \"reference\": \"payment-usd-eur-001\",\n  \"saveAccount\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/payments/external",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"payments",
								"external"
							]
						}
					},
					"response": []
				},
				{
					"name": "External Payment - USD to GBP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fromUserId\": \"11111111-1111-1111-1111-111111111111\",\n  \"amount\": \"1000.00\",\n  \"currency\": \"USD\",\n  \"targetCurrency\": \"GBP\",\n  \"externalAccountNumber\": \"9876543210\",\n  \"externalRoutingNumber\": \"123456789\",\n  \"externalBankName\": \"UK Bank\",\n  \"externalAccountHolderName\": \"Jane Smith\",\n  \"externalCountryCode\": \"GB\",\n  \"reference\": \"payment-usd-gbp-001\",\n  \"saveAccount\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/payments/external",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"payments",
								"external"
							]
						}
					},
					"response": []
				}
			],
			"description": "Example requests with sample data"
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:4078",
			"type": "string"
		},
		{
			"key": "from_user_id",
			"value": "11111111-1111-1111-1111-111111111111",
			"type": "string"
		},
		{
			"key": "to_user_id",
			"value": "22222222-2222-2222-2222-222222222222",
			"type": "string"
		},
		{
			"key": "external_account_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "payment_request_id",
			"value": "",
			"type": "string"
		}
	]
}
